# Backend
PORT=4000
GEMINI_API_KEY=your_gemini_api_key_here
# Use a model your key supports (ListModels in AI Studio / docs). Examples: gemini-2.0-flash, gemini-2.5-flash-preview
GEMINI_MODEL=gemini-2.0-flash
# Optional: HTTP line logs (default on when NODE_ENV is not production). Set to 0 to disable.
# LOG_HTTP=0

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
